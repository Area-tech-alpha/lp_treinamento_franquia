# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# URL pública do site, sem barra no final. Usada no SEO (OG image, canonical,
# sitemap). Se ficar vazia na Vercel, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp do consultor no formato wa.me (DDI + DDD + número, só dígitos).
# Os CTAs montam a mensagem dizendo de qual card a pessoa veio.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/55XXXXXXXXXXX

# Opcionais — deixe vazio para não carregar.
# Google Analytics 4 (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel (só números)
NEXT_PUBLIC_META_PIXEL_ID=
