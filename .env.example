# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# OBRIGATÓRIA — somente servidor: webhook (n8n) que recebe os leads.
# Nunca é enviada ao navegador.
LEAD_WEBHOOK_URL=https://seu-n8n.com/webhook/XXXXXXXX

# OBRIGATÓRIA — URL pública do site, sem barra no final (OG image, canonical, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# OPCIONAL — WhatsApp do time (wa.me). Só usado no botão "Falar com o time agora"
# da página /obrigado; sem ela, o botão fica oculto.
NEXT_PUBLIC_WHATSAPP_URL=

# OBRIGATÓRIA para a API de Conversões (CAPI) da Meta — somente servidor.
# Na Vercel, cadastre como Sensitive. Nunca coloque o valor no código ou em commit.
# Sem ela, o Lead do servidor não é enviado (só um aviso no log).
META_CAPI_TOKEN=

# OPCIONAL — só para teste: código da aba "Testar eventos" do Gerenciador de Eventos.
# Com ela, os eventos do servidor NÃO contam para os anúncios. Remova depois de testar.
META_CAPI_TEST_EVENT_CODE=
