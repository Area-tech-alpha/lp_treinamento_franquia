# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).
# As NEXT_PUBLIC_* são lidas no build: depois de mudar, faça redeploy.

# URL pública do site, sem barra no final (SEO: OG image, canonical, sitemap).
# Se ficar vazia na Vercel, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp do time no formato wa.me (DDI + DDD + número, só dígitos).
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/55XXXXXXXXXXX

# Meta Pixel (só números). Vazio = não carrega.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager (GTM-XXXXXXX) ou GA4 direto (G-XXXXXXXXXX). Vazio = não carrega.
NEXT_PUBLIC_GTM_ID=

# SOMENTE SERVIDOR (sem NEXT_PUBLIC): webhook do n8n que recebe os leads.
# Nunca é enviado ao navegador.
LEAD_WEBHOOK_URL=https://seu-n8n.com/webhook/XXXXXXXX
